# Server
PORT=3000

# Mode
# TEST_MODE: real API calls, but routed to sandbox/test accounts (DocuSign demo env, etc.)
# DEMO_MODE: no real API calls at all — serves canned in-memory data, safe to run with no credentials.
TEST_MODE=false
DEMO_MODE=false

# Storage backend (used only when DEMO_MODE=false):
#   excel — production: an Excel workbook in SharePoint/OneDrive via Microsoft Graph
#           (needs the Files permission + the excel.* location values in src/config.js).
#   local — a permission-free JSON file, for demos / early Sliplane deploys made before that
#           permission and file location exist. NOT durable on ephemeral hosts (resets on
#           redeploy/restart). Optionally point STORAGE_LOCAL_FILE at a mounted volume to persist.
STORAGE_BACKEND=local
# STORAGE_LOCAL_FILE=/data/onboarding-data.json

# Microsoft Graph (app-only / client credentials — Electi's Azure AD tenant).
# These values come from Electi's own tenant admin, not from you. One shared credential covers
# everything Microsoft-side: user/license/group provisioning, the Excel data store, and sending
# mail — see docs/MICROSOFT-ADMIN-SETUP.md for the full permission list.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# DocuSign (JWT Grant, server-to-server). See docs/SETUP-CHECKLIST.md.
DOCUSIGN_ENV=demo
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
# Base64-encoded PEM content — preferred for Docker/Sliplane deploys (no file to mount).
DOCUSIGN_PRIVATE_KEY_BASE64=
# Local-dev fallback if DOCUSIGN_PRIVATE_KEY_BASE64 is unset:
DOCUSIGN_PRIVATE_KEY_PATH=./docusign-private-key.pem
DOCUSIGN_CONNECT_HMAC_KEY=

# SalesScreen (static API key, sent as header "apiKey"). See docs/SETUP-CHECKLIST.md.
SALESSCREEN_API_KEY=

# Telenor order recipients — leave unset to use the real recipients hardcoded in src/config.js.
# For SAFE TESTING, set TELENOR_ORDER_TO to a test inbox (comma-separated) so a test signing never
# sends a real order to Telenor. Remove it again before go-live.
# TELENOR_ORDER_TO=din-testadresse@example.com
# TELENOR_ORDER_CC=
